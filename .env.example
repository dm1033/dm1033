# Server-side only — NEVER commit real values, never prefix with NEXT_PUBLIC_.
# Copy to .env.local for local dev; set as project env vars on Vercel/Netlify.

# Powers the AI CV review at /services/ats-cv-review (free tier).
# Get a key at https://platform.claude.com. Degrades gracefully if unset.
ANTHROPIC_API_KEY=

# Powers the fully automated paid Premium Access at /premium
# (£200/12 months or £20/month). Stripe Dashboard → Developers → API keys.
# Use sk_test_... while testing, sk_live_... for launch.
STRIPE_SECRET_KEY=

# Signs premium-access tokens. Any long random string (32+ chars), e.g.:
#   openssl rand -base64 32
# Changing it logs out all existing premium customers' devices.
PREMIUM_TOKEN_SECRET=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Safe to expose (NEXT_PUBLIC_). Analytics loads ONLY after the visitor
# accepts cookies on the banner; leave unset to disable analytics entirely.
NEXT_PUBLIC_GA_ID=
