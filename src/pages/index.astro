---
import Base from '../layouts/Base.astro';

const services = [
  {
    title: 'Falsework & formwork design',
    body: 'Design, design checks and category 3 reviews for falsework, formwork, propping and edge protection systems.',
  },
  {
    title: 'Excavation & shoring',
    body: 'Battered cuts, sheet piles, soldier piles, trench boxes and propped excavations — sized and signed off.',
  },
  {
    title: 'Wind load assessment',
    body: 'AS/NZS 1170.2 wind actions on hoarding, scaffold, sheeting and partially-clad temporary structures.',
  },
  {
    title: 'Member buckling checks',
    body: 'Compression and combined-action checks for temporary steelwork to NZS 3404 / AS 4100.',
  },
  {
    title: 'Large tracked plant design (BRE 470)',
    body: 'Ground bearing pressures, crane mat and timber pad sizing for cranes, piling rigs and excavators.',
  },
  {
    title: 'Temporary Works Coordinator support',
    body: 'TWC / TWS support, briefs, registers and check certificates aligned with BS 5975 and project procedures.',
  },
];
---
<Base title="Temporary Works Consulting & Design">
  <section class="hero">
    <div class="container hero__inner">
      <div>
        <p class="eyebrow">Temporary works design &amp; consulting · New Zealand</p>
        <h1>Temporary works designs and design checks that keep your build moving — and safe.</h1>
        <p class="lead">
          Temporary Works Consulting &amp; Design Ltd provides independent design, design
          checks and on-call engineering advice for construction, infrastructure and
          maintenance projects across Aotearoa.
        </p>
        <div class="kicker-row">
          <a class="btn btn--primary" href="/contact/">Brief us on a project</a>
          <a class="btn btn--ghost" href="/services/">Explore services</a>
        </div>
      </div>
      <aside class="hero__panel">
        <h3>What we cover</h3>
        <ul>
          <li>Falsework, formwork and propping</li>
          <li>Excavation shoring and trenching</li>
          <li>Crane and piling rig mats (BRE 470)</li>
          <li>Wind load checks (AS/NZS 1170.2)</li>
          <li>Buckling and stability checks</li>
          <li>Category 1–3 design checks</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--band">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h2>Engineering across the temporary works lifecycle.</h2>
      <p class="lead">From early-stage methodology and risk reviews through to category 3 independent checks and as-built sign-off.</p>
      <div class="grid" style="margin-top:2rem;">
        {services.map((s) => (
          <article class="card">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
      <div class="kicker-row">
        <a class="btn btn--ghost" href="/services/">See full service list →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <p class="eyebrow">How we work</p>
        <h2>Practical, code-compliant, on time.</h2>
        <p>
          We sit alongside contractors, designers and PCBUs. We turn temporary works concepts into
          checked designs, calculations and drawings, working to AS/NZS, BS 5975 and project-specific
          procedures.
        </p>
        <p>
          For sensitive or high-consequence works we provide independent (Category 3) checks —
          a second set of trained eyes on the design before it goes on site.
        </p>
      </div>
      <div>
        <ol class="steps">
          <li><strong>Brief.</strong> Drawings, sequencing, ground info, loads.</li>
          <li><strong>Design.</strong> Calculations, sketches and drawings.</li>
          <li><strong>Check.</strong> Internal or independent (Cat 1–3).</li>
          <li><strong>Issue.</strong> Signed design pack and check certificate.</li>
          <li><strong>Support.</strong> RFIs, site queries, sign-off.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="container cta">
      <div>
        <h2>Have a temporary works problem to solve?</h2>
        <p class="lead">Send drawings or a methodology and we'll come back with an approach, a fee and a timeline.</p>
      </div>
      <a class="btn btn--primary" href="/contact/">Get in touch</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 5rem 0 4rem;
    background:
      radial-gradient(800px 400px at 90% -10%, rgba(10,79,122,0.10), transparent 60%),
      linear-gradient(180deg, #ffffff, #f5f8fb);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero__panel {
    background: white;
    border: 1px solid var(--c-border);
    border-radius: var(--r);
    padding: 1.5rem;
    box-shadow: 0 1px 0 rgba(7,58,90,0.04);
  }
  .hero__panel h3 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); }
  .hero__panel ul { padding-left: 1.1rem; margin: 0; display: grid; gap: 0.4rem; }
  .two-col {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .steps {
    counter-reset: step;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .steps li {
    counter-increment: step;
    padding: 0.85rem 1rem 0.85rem 3rem;
    background: white;
    border: 1px solid var(--c-border);
    border-radius: var(--r);
    position: relative;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--c-accent);
    color: white;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  @media (max-width: 820px) {
    .hero__inner, .two-col { grid-template-columns: 1fr; }
  }
</style>
