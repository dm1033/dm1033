<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
  <link rel="canonical" href="{{ canonical or (site.url + page.url) }}" />

  <meta property="og:title" content="{{ og_title or title }}" />
  <meta property="og:description" content="{{ og_description or description }}" />
  <meta property="og:type" content="{{ og_type or 'website' }}" />
  <meta property="og:url" content="{{ canonical or (site.url + page.url) }}" />
  <meta property="og:image" content="{{ og_image or site.og_image }}" />
  <meta property="og:site_name" content="{{ site.name }}" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ og_title or title }}" />
  <meta name="twitter:description" content="{{ og_description or description }}" />
  <meta name="twitter:image" content="{{ og_image or site.og_image }}" />

  <meta name="robots" content="index,follow" />
  <meta http-equiv="content-language" content="{{ site.lang }}" />

  {% if schema_files %}
    {% for name in schema_files %}
      <script type="application/ld+json">{{ schemas[name] | jsonld | safe }}</script>
    {% endfor %}
  {% endif %}

  <link rel="stylesheet" href="/assets/css/site.css" />
</head>
<body>
  {% include "partials/header.njk" %}

  <main class="container">
    {{ content | safe }}

    <p class="cta-strip">
      <a class="btn btn-primary" href="/contact/">Request a Quote</a>
      <a class="btn" href="mailto:{{ site.contact_email }}">Email David</a>
      <a class="btn" href="{{ site.tool_url }}">Try the BRE 470 Tool</a>
    </p>
  </main>

  {% include "partials/footer.njk" %}
</body>
</html>
