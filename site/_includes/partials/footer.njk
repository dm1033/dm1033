<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand"><b>{{ site.brand }}</b></p>
      <p>{{ site.tagline }}.</p>
      <p>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a><br />
        <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>
      </p>
      <p class="small" style="color:#8ea1b6">
        {{ site.legalNameUk }}<br />
        Incorporated in {{ site.jurisdiction }} &middot; Company No. {{ site.companyNumber }}<br />
        Registered office: {{ site.registeredOffice }}
      </p>
    </div>

    <div>
      <h4>Services</h4>
      <ul>
        {%- for s in services %}
        <li><a href="/services/{{ s.slug }}/">{{ s.nav }}</a></li>
        {%- endfor %}
        <li><a href="/weekly-support/">Weekly Support</a></li>
      </ul>
    </div>

    <div>
      <h4>Company</h4>
      <ul>
        <li><a href="/services/">Services</a></li>
        <li><a href="/resources/">Resources</a></li>
        <li><a href="/case-studies/">Case Studies</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>

    <div>
      <h4>Tools &amp; sites</h4>
      <ul>
        <li><a href="{{ site.url }}">temporaryworksconsulting.com</a></li>
        <li><a href="{{ site.sisterSites.bre470 }}">{{ site.sisterSiteLabels.bre470 }}</a></li>
        <li><a href="{{ site.sisterSites.scaffold }}">{{ site.sisterSiteLabels.scaffold }}</a></li>
        <li><a href="{{ site.sisterSites.toolbox }}">{{ site.sisterSiteLabels.toolbox }}</a></li>
        <li><a href="/ebook/">Mastering Temporary Works (ebook)</a></li>
      </ul>
      <h4 style="margin-top:1.25rem">Legal</h4>
      <ul>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/privacy/#disclaimer">Disclaimer</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-disclaimer">
    Technical advice and designs are subject to project-specific information, agreed scope and formal appointment.
  </div>

  <div class="container footer-bottom">
    <span>&copy; {{ site.year }} {{ site.legalName }}. All rights reserved.</span>
    <span>{{ site.tagline }}</span>
  </div>
</footer>
